{
  "name": "eduwalls-autogtm",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous SDR agent for Eduwalls Africa: researches, qualifies, emails and follows up with Lagos private schools.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/cli.ts",
    "vercel-build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "imapflow": "^2.0.5",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
