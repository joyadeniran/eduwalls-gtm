# ---- Required at deploy time ---------------------------------------------
# Postgres connection string, any provider. Tables are created on first request.
DATABASE_URL=
# Guards the dashboard and API. Production refuses to serve without it (N9).
DASHBOARD_PASSWORD=
# Guards POST /api/cron so only the scheduler can trigger a run.
CRON_SECRET=
# Encrypts secrets saved in the dashboard. Recommended: without it they are
# stored as plain text.
APP_SECRET=

# ---- Required to do anything useful --------------------------------------
# The only key the agent needs to think. Get one at https://aistudio.google.com/apikey
# Can also be saved in the dashboard instead.
GEMINI_API_KEY=

# ---- Sending --------------------------------------------------------------
# LIVE_SEND stays false until you have watched a few sequences and trust them.
# While false, everything runs for real except the actual delivery.
LIVE_SEND=false
FROM_EMAIL=hello@myeduwalls.com
FROM_NAME=Joy Adeniran, Eduwalls Africa
REPLY_TO_EMAIL=hello@myeduwalls.com

# Pick ONE transport. Brevo wins if both are set.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Reply detection (required for live sending) --------------------------
# Without this the agent cannot see replies, so the engine refuses to deliver
# anything while LIVE_SEND is on. Dry run works without it.
# For Gmail use an App Password, not the account password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ---- CRM (optional) -------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=

# ---- Engine behaviour -----------------------------------------------------
ENGINE_ENABLED=true
ENGINE_TICK_SECONDS=300
MAX_SENDS_PER_DAY=25
MAX_SENDS_PER_TICK=5
MAX_RESEARCH_PER_TICK=3
MIN_SCORE_TO_CONTACT=60
FOLLOWUP_1_DAYS=5
FOLLOWUP_2_DAYS=10
AUTO_DISCOVER=true
DISCOVER_TARGET_BACKLOG=20
SEND_WINDOW_ENABLED=true
SEND_START_HOUR_WAT=8
SEND_END_HOUR_WAT=17

# ---- Runtime --------------------------------------------------------------
PORT=3000
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_WRITER_MODEL=gemini-2.5-flash
